{
  "name": "whataka",
  "version": "1.0.0",
  "private": true,
  "description": "WhaTaka — PWA de mensajería P2P cifrada y relé de nodos.",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "compile": "node scripts/compile.js",
    "deploy": "node scripts/deploy.js",
    "validar-token": "node scripts/validar-token.cjs",
    "test": "node --test --test-concurrency=1 --test-timeout=30000 \"test/*.test.js\"",
    "test:contract": "node --test --test-concurrency=1 --test-timeout=60000 test/contracts/mining-rewards.evm.test.js",
    "test:tokenomics": "node --test --test-concurrency=1 --test-timeout=60000 test/contracts/ttc-tokenomics.evm.test.js",
    "test:all": "npm test && npm run test:contract && npm run test:tokenomics",
    "lanzar": "node scripts/lanzar.js"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  }
}
